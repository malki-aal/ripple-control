# Optional cloud settings. The judged run needs NONE of these; leave them unset for the laptop-only run.
# Copy to .env (never commit it) or set in your shell / the platform's secret store.

# LLM extraction (Gemini). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>
# GEMINI_MODEL is chosen automatically (3.5 Flash-Lite > 3.1 Flash-Lite > 2.5 Flash-Lite); override with run.py --model

# Pseudonymization key for exported audit facts (keeps joins stable across re-exports)
RIPPLE_PSEUDONYM_KEY=<long-random-string>

# Snowflake (integrations/snowflake/load.py)
SNOWFLAKE_ACCOUNT=<orgname-accountname>
SNOWFLAKE_USER=<user>
SNOWFLAKE_PASSWORD=<password-or-leave-empty-if-using-key-pair>
SNOWFLAKE_PRIVATE_KEY_FILE=<path/to/rsa_key.p8 (optional, preferred)>
SNOWFLAKE_AUTHENTICATOR=<SNOWFLAKE_JWT for key-pair login; externalbrowser only works with SAML SSO>
SNOWFLAKE_ROLE=<role>
SNOWFLAKE_WAREHOUSE=<warehouse>
SNOWFLAKE_DATABASE=<database>
SNOWFLAKE_SCHEMA=RIPPLE_AUDIT

# Databricks (import integrations/databricks/ripple_graph_build.py as a notebook; set its widgets)
#   source       = /Volumes/<catalog>/<schema>/extracts          (upload the 16 CSVs, or synthetic/redacted copies)
#   local_export = /Volumes/<catalog>/<schema>/exports/run1      (upload runs/run1/export/graph_*.csv + manifest.json)
#   target       = <catalog>.ripple_graph
DATABRICKS_HOST=<https://dbc-xxxx.cloud.databricks.com>
DATABRICKS_TOKEN=<personal-access-token>

# MongoDB Atlas precedent search (integrations/mongodb/precedents.py)
MONGODB_URI=<mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority>
MONGODB_DB=ripple
