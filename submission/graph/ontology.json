      "dst": "Shipment",
      "meaning": "supplier sends an inbound shipment"
    },
    "SHIPMENT_OF_PART": {
      "src": "Shipment",
      "dst": "Part",
      "meaning": "shipment carries a part"
    },
    "SHIPMENT_TO_PLANT": {
      "src": "Shipment",
      "dst": "Plant",
      "meaning": "shipment is received at a plant"
    },
    "PART_IN_MODEL": {
      "src": "Part",
      "dst": "Model",
      "meaning": "bill of materials: model requires part"
    },
    "PLANT_BUILDS_MODEL": {
      "src": "Plant",
      "dst": "Model",
      "meaning": "plant is able to build the model"
    },
    "PLANT_SCHEDULES_ORDER": {
      "src": "Plant",
      "dst": "ProductionOrder",
      "meaning": "order is built at the plant"
    },
    "ORDER_OF_MODEL": {
      "src": "ProductionOrder",
      "dst": "Model",
      "meaning": "order builds this model"
    },
    "ORDER_FULFILLS_CO": {
      "src": "ProductionOrder",
      "dst": "CustomerOrder",
      "meaning": "customer order is filled by the build"
    },
    "CO_AT_DEALER": {
      "src": "CustomerOrder",
      "dst": "Dealer",
      "meaning": "customer order placed through dealer"
    },
    "CO_FOR_CUSTOMER": {
      "src": "CustomerOrder",
      "dst": "Customer",
      "meaning": "customer order belongs to customer"
    },
    "SUPPLIES_LOT": {
      "src": "Supplier",
      "dst": "Lot",
      "meaning": "supplier produced the part lot"
