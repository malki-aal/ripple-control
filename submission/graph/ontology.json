      "src": "Vehicle",
      "dst": "Dealer",
      "meaning": "vehicle is allocated to dealer"
    },
    "VEHICLE_OWNED_BY": {
      "src": "Vehicle",
      "dst": "Customer",
      "meaning": "sold vehicle owner"
    },
    "DEALER_HAS_LOANER_POOL": {
      "src": "Dealer",
      "dst": "LoanerPool",
      "meaning": "dealer's loaner pool"
    }
